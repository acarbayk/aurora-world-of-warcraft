<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Languages</name>
		<description>Languages of Azeroth from World of Warcraft (Andrey Kuzinskiy). Common and Orcish use the core Common and Orc languages.</description>
		<author url="https://github.com/acarbayk/aurora-world-of-warcraft">Andrey Kuzinskiy (book), converted by Kaya Acarbay</author>
		<update version="1.0.0">
			<file name="wow-languages.xml" url="https://raw.githubusercontent.com/acarbayk/aurora-world-of-warcraft/main/world-of-warcraft/misc/wow-languages.xml" />
		</update>
	</info>

	<element name="Common Sign Language" type="Language" source="World of Warcraft" id="ID_KAYA_WOW_LANGUAGE_COMMON_SIGN_LANGUAGE">
		<requirements>!(ID_WOTC_PHB24_LANGUAGE_COMMON_SIGN)</requirements>
		<supports>WoW Alliance Language</supports>
		<description>
			<p>Typically spoken by Humans.</p>
		</description>
		<setters>
			<set name="speakers">Humans</set>
			<set name="standard">true</set>
		</setters>
	</element>

